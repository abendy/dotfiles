<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abendy.tmux-reap</string>
  <!-- Closes idle tmux terminals and removes idle sessions every 15 minutes.
       See bin/tmux-reap. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/bin/tmux-reap</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <!-- Same locale as the tmux-server agent; see its plist -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tmux-reap.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tmux-reap.log</string>
</dict>
</plist>
