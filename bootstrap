#!/usr/bin/env bash

# Resolved at script scope, not inside install_dotfiles. configure_editor reads
# current_path too and runs unconditionally, whereas install_dotfiles only runs
# if the user accepts its prompt - so assigning these inside install_dotfiles
# left them empty on the decline path, and configure_editor silently tried to
# `cp -f "/localrc"` while still printing a success line.
DOTFILES_DIR="$HOME/.dotfiles"
current_path="$DOTFILES_DIR"

function auto_update {
  # Operate on the deploy clone explicitly rather than on $PWD. auto_update is
  # the first thing the script calls and nothing has cd'd yet - the only
  # `cd "$DOTFILES_DIR"` lives inside install_dotfiles, much later and behind a
  # prompt. Without this, `cd ~/somewhere-else && ~/.dotfiles/bootstrap` would
  # fetch and `git reset --hard origin/master` whatever repo you were standing
  # in, because the guard below only asks "is there a master branch here?".
  # Resetting ~/.dotfiles is intentional - it's a deploy target, not a working
  # copy - but resetting the repo you develop in would discard real work.
  if [ ! -d "$DOTFILES_DIR/.git" ]; then
    return
  fi

  cd "$DOTFILES_DIR" || return

  if [ "$(git branch --list master)" ]; then
    echo "Pulling from GitHub..."

    git fetch origin &> /dev/null

    if [ -n "$(git log HEAD..origin/master)" ]; then
      echo Hell yeah, running self-update process...
      git reset --hard origin/master &> /dev/null
      # Relative re-exec is safe now that we've cd'd into the deploy clone;
      # previously it re-ran whichever bootstrap happened to sit in $PWD
      ./$(basename $0) && exit
    fi

    success "Done"
  fi
}

function install_command_line_tools {
  if xcode-select -p 1> /dev/null; then
    return
  fi

  echo "To install the OS X Command Line Tools, click on the install button on the dialogue that appears"
  echo -en "\tPress enter to continue... "
  read

  xcode-select --install

  echo -en "\tPress enter when the installation is complete"
  read

  if xcode-select -p 1> /dev/null; then
    success "Done installing OS X Command Line Tools"
  else
    fail "Command line tools not found"
  fi
}

function install_homebrew {
  if ! hash brew &> /dev/null; then
    echo "Installing Homebrew"
    (cd ~; echo -en "\n" | /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" &> /dev/null)
    success "Done installing Homebrew"
  fi
}

function is_brew_installed {
  for i in $(brew list -1); do
    if [[ "$i" == "$1" ]]; then
      echo 1;
    fi;
  done
}

function install_brews {
  if hash brew &> /dev/null; then

    echo "Updating the Brew repository..."
    brew update &> /dev/null

    brews_installed=0;

    if [[ $1 == "ZSH" ]]; then
      for brew in {antidote,zsh,zsh-completions,zsh-history-substring-search,zsh-syntax-highlighting}; do
        if [ -z "$(is_brew_installed $brew)" ]; then
          echo "Installing $brew"

          if brew install $brew &> "$HOME/.dotfiles/dotfiles.log"; then
            ((brews_installed++))
          else
            fail "Failed to install $brew - see $HOME/.dotfiles/dotfiles.log for details"
          fi
        elif [ -n "$(brew outdated $brew)" ]; then
          echo "Upgrading $brew"

          if brew upgrade $brew &> "$HOME/.dotfiles/dotfiles.log"; then
            ((brews_installed++))
          else
            fail "Failed to upgrade $brew - see $HOME/.dotfiles/dotfiles.log for details"
          fi
        fi
      done
      unset brew

    else
      echo "Installing all Brews"

      # Absolute path so this doesn't depend on the caller's cwd, and
      # `tee` so failures are visible instead of silently sitting in the
      # log - PIPESTATUS[0] is needed because `tee`'s own exit status
      # (not brew bundle's) is what `$?`/an `if` on the pipeline would see.
      # `2>&1` because brew writes Error:/Warning: to stderr, so without it
      # the log records only the successes and the `fail` below points at a
      # log with the reason for the failure missing
      brew bundle install --verbose --file="$HOME/.dotfiles/Brewfile" 2>&1 | tee "$HOME/.dotfiles/dotfiles.log"

      if [ ${PIPESTATUS[0]} -eq 0 ]; then
        ((brews_installed++))
      else
        fail "Failed to install Brewfile - see $HOME/.dotfiles/dotfiles.log for details"
      fi
    fi

    if [ $brews_installed -gt 0 ]; then
      success "Done installing Brews and Casks"
    else
      success "Nothing to install or update"
    fi

  fi
}

function install_oh_my_zsh {
  if [ -z "$ZSH" ]; then
    ZSH=$HOME/.oh-my-zsh
  fi

  if [ ! -d "$ZSH" ]; then
    echo -en "Installing Oh My Zsh\n"

    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" &> /dev/null

    # https://www.iterm2.com/documentation-shell-integration.html
    sh -c "$(curl -L https://iterm2.com/misc/install_shell_integration.sh | bash)" &> /dev/null

    success "Done installing Oh My Zsh"
  else
    echo "Upgrading Oh My Zsh"

    env ZSH=$ZSH sh $ZSH/tools/upgrade.sh &> /dev/null

    success "Done upgrading Oh My Zsh"
  fi
}

function install_dotfiles {
  git_user_name="$(git config --get user.name | tr -d '\n')"
  git_user_email="$(git config --get user.email | tr -d '\n')"
  # user.signingkey is deliberately *not* captured and restored any more. It
  # used to hold a machine-specific GPG key id, so it had to survive the
  # gitconfig copy below. It's now a fixed path (~/.ssh/git_signing.pub) that is
  # identical on every machine while the key behind it differs, so the tracked
  # value is already correct and restoring an old GPG id would undo it.

  if [ ! -d "$DOTFILES_DIR" ]; then
    fail "Clone dotfiles to ~/.dotfiles and re-run bootstrap"
  fi

  # Unconditional - `cd` to where we already are is a no-op. The old guard
  # compared ${PWD##*/} (a basename, e.g. "dotfiles") against "$DOTFILES_DIR"
  # (a full path), which could never match, so it always took the cd branch
  # anyway while reading files from the pre-cd $PWD.
  cd "$DOTFILES_DIR"

  # "input", not "inputrc" - the repo file is `input` and zshrc sources
  # `~/.input`. The old "inputrc" entry silently matched nothing (the `-f`
  # test below just skipped it), so no keybindings from that file were ever
  # installed on any machine bootstrapped by this script
  for file in "aliases" "exports" "functions" "gitconfig" "gitignore" "gitmessage" "input" "zshrc" "zprofile" "zshenv"; do
    complete_file_path=${current_path}/${file}

    if [ -f ${complete_file_path} ]; then
      rm -f $HOME/.${file}
      cp -f ${complete_file_path} $HOME/.${file}
    fi
  done
  unset file
  success "Done copying dotfiles to your home directory"

  # Restore git user & email immediately - the copy above just overwrote
  # ~/.gitconfig with this repo's blank [user] placeholder, so this can't
  # wait until after the (network-dependent) steps below
  if [ -n "$git_user_name" ] || [ -n "$git_user_email" ]; then
    echo ${git_user_name} \<${git_user_email}\>

    echo
    read -p "Are these your git user details? (y/n) " -n 1 -r
    echo
  else
    REPLY="n"
  fi

  if [[ $REPLY =~ ^[Yy]$ ]]; then
    git config --global user.name "${git_user_name}"
    git config --global user.email "${git_user_email}"
    success "Cool"
  else
    echo "Setup your git user details"

    read -p "Enter your git name: " git_user_name
    git config --global user.name "${git_user_name}"

    read -p "Enter your git email: " git_user_email
    git config --global user.email "${git_user_email}"

    success "Saved"
  fi

  if [ ! -d $HOME/bin ]; then
    mkdir -p $HOME/bin
  fi

  for file in ${current_path}/bin/*; do
    binlink=$HOME/bin/$(basename ${file})
    rm -f ${binlink}
    cp -f ${file} ${binlink}
    chmod +x ${binlink}
  done
  unset file
  success "Done copying custom commands to your home bin directory"

  if [ ! -d $HOME/.hammerspoon ]; then
    mkdir -p $HOME/.hammerspoon
  fi

  if [ -f ${current_path}/hammerspoon-init.lua ]; then
    cp -f ${current_path}/hammerspoon-init.lua $HOME/.hammerspoon/init.lua
    success "Done copying Hammerspoon config"
  fi

  if [ -f ${current_path}/iterm2/com.googlecode.iterm2.plist ]; then
    cp -f ${current_path}/iterm2/com.googlecode.iterm2.plist $HOME/Library/Preferences/com.googlecode.iterm2.plist
    # cfprefsd caches preferences in memory, so a plist overwritten on disk
    # isn't picked up until it's restarted - ideally run this before iTerm2
    # is launched for the first time on a new machine
    killall cfprefsd &> /dev/null
    success "Done copying iTerm2 preferences"
  fi

  if [ -f ${current_path}/tmux.conf ]; then
    cp -f ${current_path}/tmux.conf $HOME/.tmux.conf
    success "Done copying tmux config"
  fi

  if [ -f ${current_path}/atuin/config.toml ]; then
    mkdir -p "$HOME/.config/atuin"
    if cp -f ${current_path}/atuin/config.toml "$HOME/.config/atuin/config.toml"; then
      chmod 600 "$HOME/.config/atuin/config.toml"
      success "Installed Atuin config"
    else
      fail "Failed to install Atuin config"
    fi
  fi

  success "Completed dotfiles bootstrapping"

  # Bundle ZSH plugins using antidote plugin manager
  echo "Bundling ZSH plugins"
  if [ ! -f $DOTFILES_DIR/zsh/plugins.txt ]; then
    fail "Missing ZSH plugins files for Antidote"
  else
    # antidote ships as a zsh function, not a PATH-resolvable binary, so it
    # has to be sourced inside a zsh subshell rather than run directly here.
    # GIT_TERMINAL_PROMPT=0 makes a dead/private plugin repo fail fast
    # instead of hanging on an interactive credential prompt.
    if GIT_TERMINAL_PROMPT=0 zsh -c 'source "$(brew --prefix)/opt/antidote/share/antidote/antidote.zsh" && antidote bundle' < $DOTFILES_DIR/zsh/plugins.txt > $HOME/.zsh_plugins.sh; then
      success "Done bundling ZSH plugins"
    else
      fail "Failed to bundle ZSH plugins with Antidote"
    fi
  fi
}

function configure_editor {
  local_rc="$HOME/.localrc"

  if [ ! -f "$local_rc" ]; then
    # Checked, not fire-and-forget - the previous version printed the success
    # line whatever `cp` returned, so a failed copy reported OK and the editor
    # block below was then appended to a file that didn't exist yet
    if cp -f "${current_path}/localrc" "$local_rc"; then
      success "Copied localrc template to $local_rc"
    else
      fail "Failed to copy ${current_path}/localrc to $local_rc"
    fi
  fi

  echo
  read -p "Preferred editor for local sessions [code]: " editor_local
  editor_local=${editor_local:-code}

  read -p "Preferred editor for remote/SSH sessions [vim]: " editor_remote
  editor_remote=${editor_remote:-vim}

  # Drop any previously written block so re-running bootstrap doesn't duplicate it
  # (GNU sed's -i takes no space-separated argument; BSD sed requires one, even if empty)
  if sed --version &> /dev/null; then
    sed -i '/# >>> dotfiles: editor >>>/,/# <<< dotfiles: editor <<</d' "$local_rc"
  else
    sed -i '' '/# >>> dotfiles: editor >>>/,/# <<< dotfiles: editor <<</d' "$local_rc"
  fi

  cat >> "$local_rc" <<EOF

# >>> dotfiles: editor >>>
if [[ -n \$SSH_CONNECTION ]]; then
  export EDITOR='${editor_remote}'
else
  export EDITOR='${editor_local}'
fi
# <<< dotfiles: editor <<<
EOF

  success "Saved editor preferences to $local_rc"
}

function configure_git_signing {
  # gitconfig sets commit.gpgsign with gpg.format = ssh, so commits need an SSH
  # signing key present or every commit fails. A key with no passphrase is the
  # point: it signs unattended on the Mini over SSH, where GPG would fall back
  # to curses pinentry and prompt, and where 1Password's agent can't help
  # because it needs the desktop GUI to approve.
  local signing_key="$HOME/.ssh/git_signing"
  local allowed_signers="$HOME/.ssh/allowed_signers"

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  if [ ! -f "$signing_key" ]; then
    echo "Generating a git signing key for this machine"
    # Signing only - this key must never go into any authorized_keys, so
    # compromise means forged signatures rather than server access
    if ssh-keygen -t ed25519 -f "$signing_key" -N "" -q \
         -C "git signing - $(hostname -s) - $(date +%Y-%m)"; then
      success "Generated $signing_key"
      echo
      echo "Register this key in two places:"
      echo
      echo "  1. github.com/settings/keys > New SSH key"
      echo "     Set the \"Key type\" dropdown to \"Signing Key\" - it defaults"
      echo "     to \"Authentication Key\". There is no separate signing-key"
      echo "     page; that heading only appears once one exists."
      echo "  2. git-allowed-signers in this repo, so local verification works"
      echo
      cat "${signing_key}.pub"
      echo
    else
      fail "Could not generate $signing_key"
    fi
  fi

  chmod 600 "$signing_key"
  chmod 644 "${signing_key}.pub"

  if [ -f "${current_path}/git-allowed-signers" ]; then
    if cp -f "${current_path}/git-allowed-signers" "$allowed_signers"; then
      chmod 644 "$allowed_signers"
      success "Installed $allowed_signers"
    else
      fail "Failed to copy git-allowed-signers to $allowed_signers"
    fi
  fi
}

function fix_insecure_directories {
  # zsh's compinit refuses to load completions from any directory in its
  # search path that's group- or world-writable (mainly under Homebrew's
  # share/ tree), since another user with write access there could plant
  # a completion script that runs code the next time a shell starts. That
  # shows up as an "insecure directories" prompt every time zshrc runs
  # compinit. Fixing permissions once here means it never has to ask.
  # compaudit is a zsh-only autoloaded function, not a binary, so it has
  # to run inside a zsh subshell rather than directly from this script.
  echo "Checking for insecure zsh completion directories..."

  local insecure_dirs
  insecure_dirs="$(zsh -c 'autoload -Uz compaudit && compaudit' 2>/dev/null)"

  if [ -n "$insecure_dirs" ]; then
    echo "$insecure_dirs" | xargs chmod g-w,o-w
    success "Fixed insecure completion directory permissions"
  else
    success "No insecure completion directories found"
  fi
}

function success () {
  echo -e "[ \033[00;32mOK\033[0m ] $1\n"
}

function fail () {
  echo -e "[\033[0;31mFAIL\033[0m] $1\n"
  # `exit 1`, not a bare `exit` - a bare `exit` returns the status of the
  # last command run (the `echo` above, so 0), which would report success
  # to callers, `&&` chains and CI even as it prints FAIL to the terminal
  exit 1
}

# Ask for the administrator password upfront.
sudo -v

# Keep-alive: update existing `sudo` time stamp until the script has finished.
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

auto_update
install_command_line_tools
install_homebrew

read -p "$(tput setaf 4)$(tput bold)Ready to install brews. This will install ALL brews and casks in the Brewfile. Are you sure? (y/n) $(tput sgr 0)" -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
  success "Cool"

  install_brews
else
  success "Cool"

  install_brews ZSH
fi

install_oh_my_zsh
fix_insecure_directories

read -p "$(tput setaf 4)$(tput bold)Ready to install dotfiles. This will overwrite any matching existing files in your home directory. Are you sure? (y/n) $(tput sgr 0)" -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
  success "Cool"

  install_dotfiles
fi

configure_editor
configure_git_signing

echo "Reloading shell..."
exec zsh
