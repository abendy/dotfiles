#!/usr/bin/env zsh

# Simple backup
function backup() {
  mv "$1" "$1.backup"
}

# All the dig info
function digga() {
  dig +nocmd "$1" any +multiline +noall +answer
}

# `e` with no arguments opens the current directory in Sublime Text, otherwise
# opens the given location
function e() {
  if [ $# -eq 0 ]; then
    code .;
  else
    code "$@";
  fi;
}

# credit: http://nparikh.org/notes/zshrc.txt
# Usage: extract <file>
# Description: extracts archived files / mounts disk images
# Note: .dmg/hdiutil is Mac OS X-specific.
function extract() {
  if [ -f $1 ]; then
    case $1 in
      *.tar.bz2)  tar -jxvf $1                        ;;
      *.tar.gz)   tar -zxvf $1                        ;;
      *.bz2)      bunzip2 $1                          ;;
      *.dmg)      hdiutil mount $1                    ;;
      *.gz)       gunzip $1                           ;;
      *.tar)      tar -xvf $1                         ;;
      *.tbz2)     tar -jxvf $1                        ;;
      *.tgz)      tar -zxvf $1                        ;;
      *.zip)      unzip $1                            ;;
      *.ZIP)      unzip $1                            ;;
      *.pax)      cat $1 | pax -r                     ;;
      *.pax.Z)    uncompress $1 --stdout | pax -r     ;;
      *.Z)        uncompress $1                       ;;
      *)          echo "'$1' cannot be extracted/mounted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# No arguments: `git status`
# With arguments: acts like `git`
# unalias g
function g() {
  if [[ $# > 0 ]]; then
    git $@
  else
    git status
  fi
}

# Complete g like git
compdef g=git
compdef tig=git

# Create a new directory and enter it
function mkd() {
  mkdir -p "$@" && cd "$@"
}

# Usage: mv oldfilename
# If you call mv without the second parameter it will prompt you to edit the filename on command line.
# Original mv is called when it's called with more than one argument.
function mv() {
  if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    command mv "$@"
    return
  fi

  read -ei "$1" newfilename
  command mv -v -- "$1" "$newfilename"
}

# `o` with no arguments opens current directory, otherwise opens the given
# location
function o() {
  if [ $# -eq 0 ]; then
    open .
  else
    open "$@"
  fi
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
  local tmpFile="${@%/}.tar"
  tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

  size=$(
    stat -f"%z" "${tmpFile}" 2> /dev/null; # OS X `stat`
    stat -c"%s" "${tmpFile}" 2> /dev/null # GNU `stat`
  )

  local cmd=""
  if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
    # the .tar file is smaller than 50 MB and Zopfli is available; use it
    cmd="zopfli"
  else
    if hash pigz 2> /dev/null; then
      cmd="pigz"
    else
      cmd="gzip"
    fi
  fi

  echo "Compressing .tar using \`${cmd}\`…"
  "${cmd}" -v "${tmpFile}" || return 1
  [ -f "${tmpFile}" ] && rm "${tmpFile}"
  echo "${tmpFile}.gz created successfully."
}

# `v` with no arguments opens the current directory in Vim, otherwise opens the
# given location
function v() {
  if [ $# -eq 0 ]; then
    vim .
  else
    vim "$@"
  fi
}

# --- tmux (server side, mainly the Mini) ---

# new-or-attach a session (default `main`); switches if already inside tmux
function t() {
  local name=${1:-main}
  if [[ -n $TMUX ]]; then
    tmux has-session -t "$name" 2>/dev/null || tmux new-session -d -s "$name"
    tmux switch-client -t "$name"
  else
    tmux new-session -A -s "$name"
  fi
}

# list sessions
function tl() {
  tmux ls 2>/dev/null || echo "no tmux sessions"
}

# attach/select an existing session; fzf-pick when no name given
function ta() {
  local name=$1
  if [[ -z $name ]]; then
    if command -v fzf >/dev/null; then
      name=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
             | fzf --height 40% --reverse) || return
    else
      tl
      return
    fi
  fi
  if [[ -n $TMUX ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach -t "$name"
  fi
}

# contextual: session named after the current git repo (else the current dir)
function tt() {
  local root name
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
  name=${root:t}              # zsh basename
  t "${name//[.: ]/-}"       # tmux dislikes . and : in names
}

# contextual: session named after the current git branch (else the short SHA)
function tb() {
  local branch
  branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) \
    || branch=$(git rev-parse --short HEAD 2>/dev/null) \
    || { echo "tb: not in a git repo" >&2; return 1; }
  t "${branch//[\/.: ]/-}"   # tmux dislikes / . : in names
}

# detach the current client
function td() {
  tmux detach-client "$@"
}

# rename the current session
function tn() {
  tmux rename-session "$1"
}

# kill a session (current if unnamed) — only after confirmation
function tk() {
  local name=${1:-$(tmux display-message -p '#S' 2>/dev/null)}
  if [[ -z $name ]]; then
    echo "tk: no session"
    return 1
  fi
  if read -q "REPLY?Kill tmux session '$name'? [y/N] "; then
    echo
    tmux kill-session -t "$name"
  else
    echo
  fi
}

# --- connect to the Mini (client side, the MacBook) ---
# `nigiri` is the ~/.ssh/config Host (Tailscale MagicDNS); swap the token if renamed.

# mosh in and land straight in a tmux session (default `main`)
function mini() {
  mosh nigiri -- tmux new-session -A -s "${1:-main}"
}
