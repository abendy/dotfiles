#!/usr/bin/env bash

# Settings for a Mac that runs headless (no display attached) most of the
# time, so it stays reachable over SSH/Tailscale without needing physical
# access. Run once per headless machine - ideally while a display/keyboard
# is still attached, in case something needs fixing afterward.
#
# FileVault + automatic login is deliberately NOT handled here - see
# mac-mini-setup.md. Full-disk encryption's pre-boot unlock always requires
# someone physically at the keyboard; no script can change that.

readonly DEVBOX_NAME="nigiri-san"

# Ask for the administrator password upfront
sudo -v

# Keep-alive: update existing `sudo` time stamp until this has finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

#/
 # Identity
 # ==========================================================
 #/

# Set every macOS name explicitly. Without HostName, macOS can accept a
# DHCP-provided name such as Mac-3.lan even when ComputerName and
# LocalHostName are already correct.
sudo scutil --set ComputerName "$DEVBOX_NAME"
sudo scutil --set LocalHostName "$DEVBOX_NAME"
sudo scutil --set HostName "$DEVBOX_NAME"

#/
 # Sleep
 # ==========================================================
 #/

# Never sleep - a Mac mini only ever runs on AC power, so there's no
# separate battery profile to also set
sudo pmset -c sleep 0
sudo pmset -c disksleep 0

# Wake for network access, so Wake-on-LAN / a Tailscale ping can wake it
# if it ever ends up sleeping anyway
sudo pmset -c womp 1

# Restart automatically after a power failure - there's no one there to
# flip it back on. macOS 26.5 has been seen leaving this 0 even after
# this line ran (#24), so read the persisted value back and complain
# instead of trusting the exit code.
sudo pmset -c autorestart 1
if [ "$(pmset -g custom | awk '$1 == "autorestart" { print $2 }')" != "1" ]; then
  echo "WARNING: autorestart did not persist (macOS 26.5 zeroes it; see" >&2
  echo "         abendy/dotfiles#24). Try System Settings > Energy." >&2
fi

# macOS 26.5 added autorestartatconnect - "Start up when power is
# connected" in System Settings > Energy, on 2024-or-later Mac minis.
# "Always" (1) is what actually brings a headless box back after an
# outage: power coming back counts as a connect. The OS/GUI owns it
# (pmset writes to it error on some Apple Silicon Macs), so verify only;
# fix it in the Energy pane if it ever reads 0.
if [ "$(pmset -g custom | awk '$1 == "autorestartatconnect" { print $2 }')" != "1" ]; then
  echo "WARNING: autorestartatconnect is 0 - set System Settings > Energy >" >&2
  echo "         \"Start up when power is connected\" to Always (see #24)." >&2
fi

#/
 # Lock Screen
 # ==========================================================
 #/

# Turn display off after 10 minutes of inactivity - independent of system
# sleep above, so it doesn't affect SSH/Tailscale reachability, just
# whatever display happens to be connected on the rare occasion there is one
sudo pmset -c displaysleep 10

# Start screen saver after 10 minutes of inactivity
defaults -currentHost write com.apple.screensaver idleTime -int 600

# Require password immediately after sleep or screen saver begins - matters
# more here than on a machine that's usually attended, since this one sits
# reachable on the network unattended most of the time
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0

#/
 # Remote access
 # ==========================================================
 #/

# Enable Remote Login (SSH). If this errors ("You need to enable Remote
# Login under the Sharing panel..."), grant Terminal Full Disk Access in
# System Settings > Privacy & Security and re-run - `systemsetup` needs it
# on recent macOS.
sudo systemsetup -setremotelogin on

# Enable Screen Sharing as a GUI fallback for the rare case something
# needs to be seen rather than SSH'd into. The first connection may still
# prompt for Screen Recording / Accessibility permission locally - that's
# Apple's TCC privacy prompt and can't be scripted around.
sudo /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart \
  -activate -configure -access -on -restart -agent -privs -all
