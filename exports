#!/usr/bin/env zsh

# Prefer US English and use UTF-8
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Link Homebrew casks in `/Applications` rather than `~/Applications`
export HOMEBREW_CASK_OPTS="--appdir=/Applications"

# PATH
export PATH="/usr/local/sbin:/usr/sbin:/sbin:$PATH"
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH="$(brew --prefix)/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# Eza
export EZA_COLORS="ur=37:uw=37:ux=37:ue=37:gr=37:gw=37:gx=37:tr=37:tw=37:tx=37:sn=38;5;240:sb=38;5;240:uu=1;38;5;10:un=38;5;10:da=38;5;25:di=38;5;75"

# Coreutils
if [ -n "$(brew --prefix coreutils)" ]; then
  export PATH="$(brew --prefix coreutils)/libexec/gnubin:$PATH"
fi

# Curl
export PATH="$(brew --prefix curl)/bin:$PATH"

# Findutils
export PATH="$(brew --prefix findutils)/libexec/gnubin:$PATH"

# fzf
hash fzf &> /dev/null && source <(fzf --zsh)

# 1Password SSH agent
# `ssh` picks the agent up from IdentityAgent in ~/.ssh/config, but ssh-add,
# git, rsync and mosh all read SSH_AUTH_SOCK instead - so point that at the same
# socket rather than leaving them with no agent at all.
#
# Deliberately skipped over SSH: sshd sets SSH_AUTH_SOCK itself for a forwarded
# agent, and overwriting it would break agent forwarding to the Mini. Also
# skipped when the socket is absent, i.e. 1Password isn't running or installed,
# so a machine without it just falls back to on-disk keys.
if [ -z "$SSH_CONNECTION" ]; then
  _onepassword_agent="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  [ -S "$_onepassword_agent" ] && export SSH_AUTH_SOCK="$_onepassword_agent"
  unset _onepassword_agent
fi

# GPG
# gpg-agent needs to know which terminal to attach a curses pinentry to.
# Without this, signing from a shell fails with "Inappropriate ioctl for
# device" - the same error that makes any non-interactive `git commit` on a
# gpgsign=true repo fail.
if [ -t 0 ]; then
  export GPG_TTY="$(tty)"
fi

# gpg-agent is a daemon and doesn't inherit SSH_CONNECTION, so `bin/pinentry-auto`
# can't detect a remote session on its own. PINENTRY_USER_DATA is forwarded by
# gpg-agent to the pinentry process, so it's how we tell the wrapper to use the
# curses UI instead of opening a GUI dialog on a display nobody is looking at.
if [ -n "$SSH_CONNECTION" ]; then
  export PINENTRY_USER_DATA="USE_CURSES=1"
fi

# Grep
export PATH="$(brew --prefix grep)/libexec/gnubin:$PATH"

# OpenSSL
if [ -n "$(brew --prefix openssl@3)" ]; then
  export PATH="$(brew --prefix openssl@3)/bin:$PATH"
fi

# Sed
export PATH="$(brew --prefix gnu-sed)/libexec/gnubin:$PATH"

# Tar
export PATH="$(brew --prefix gnu-tar)/libexec/gnubin:$PATH"

# User (inc. bins supplied by this repo)
export PATH="$HOME/bin:$PATH"

# Exports PATH for in-project git repositories e.g. `./bin`
export PATH=".git/safe/../../bin:$PATH"
