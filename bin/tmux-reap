#!/usr/bin/env bash
#
# Close idle tmux terminals and remove idle tmux sessions on the Mini.
#
# The Claude desktop app runs every Terminal tab over one SSH connection, and
# sshd caps the sessions per connection (MaxSessions, set by osx-devbox). Tabs
# left attached to tmux, often by sessions the app already closed, fill that
# cap. Each tab also gets its own tmux session named after its folder, so
# sessions for worktrees and scratch folders pile up.
#
# The com.abendy.tmux-reap LaunchAgent runs this every 15 minutes:
#
#   - A terminal attached to tmux with no typing for the timeout gets
#     detached and its login shell hung up, which frees its SSH slot. The tmux
#     session stays; reopening the tab reattaches.
#   - A session with nothing attached, idle for the timeout, gets removed, but
#     only when every pane sits at a shell prompt. A session running claude, a
#     server, or anything else is never removed. `phone` is never removed.
#
# Temporary folders (worktrees, /tmp, and folders that no longer exist) time
# out sooner. See remote-workflow.md.

set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# tmux prints tabs in -F output as `_` without a UTF-8 locale (see tmux-aqua)
if [ -z "${LC_ALL:-}${LC_CTYPE:-}${LANG:-}" ]; then
  export LANG="en_US.UTF-8"
fi

# Timeouts, in hours
TEMP_TERMINAL_HOURS="${TMUX_REAP_TEMP_TERMINAL_HOURS:-4}"
TERMINAL_HOURS="${TMUX_REAP_TERMINAL_HOURS:-24}"
TEMP_SESSION_HOURS="${TMUX_REAP_TEMP_SESSION_HOURS:-24}"
SESSION_HOURS="${TMUX_REAP_SESSION_HOURS:-168}"
KEEP_SESSION="phone"

DRY_RUN=0

usage() {
  cat <<'EOF'
Usage:
  tmux-reap             close idle terminals and remove idle sessions
  tmux-reap --dry-run   print what it would do, change nothing
EOF
}

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') tmux-reap: $*"
}

act() {
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "would $1"
  else
    log "$1"
    shift
    "$@"
  fi
}

is_temporary() {
  [ -d "$1" ] || return 0
  case "$1" in
    */.claude/worktrees/*|*/.codex/worktrees/*) return 0 ;;
    /tmp|/tmp/*|/private/tmp|/private/tmp/*|/private/var/folders/*) return 0 ;;
  esac
  return 1
}

# Succeeds when every pane in the session runs a bare shell
all_panes_idle() {
  local cmd
  while IFS= read -r cmd; do
    case "${cmd#-}" in
      zsh|bash|sh|fish) ;;
      *) return 1 ;;
    esac
  done < <(tmux list-panes -s -t "=$1" -F '#{pane_current_command}' 2> /dev/null)
}

# Newest activity across the session and its windows, as epoch seconds
last_activity() {
  local newest=$2 t
  while IFS= read -r t; do
    [ "$t" -gt "$newest" ] && newest=$t
  done < <(tmux list-windows -t "=$1" -F '#{window_activity}' 2> /dev/null)
  echo "$newest"
}

reap_terminals() {
  local tty activity session dir limit idle
  while IFS=$'\t' read -r tty activity session dir; do
    if is_temporary "$dir"; then limit=$TEMP_TERMINAL_HOURS; else limit=$TERMINAL_HOURS; fi
    idle=$(( (NOW - activity) / 3600 ))
    if [ "$idle" -ge "$limit" ]; then
      # -P hangs up the client's parent, the login shell, which closes the
      # terminal and its SSH channel
      act "close terminal $tty (session $session, ${idle}h without typing)" \
        tmux detach-client -P -t "$tty"
    fi
  done < <(tmux list-clients -F '#{client_tty}	#{client_activity}	#{session_name}	#{session_path}' 2> /dev/null)
}

reap_sessions() {
  local name attached activity dir limit idle why
  while IFS=$'\t' read -r name attached activity dir; do
    [ "$name" = "$KEEP_SESSION" ] && continue
    [ "$attached" -eq 0 ] || continue
    all_panes_idle "$name" || continue
    idle=$(( (NOW - $(last_activity "$name" "$activity")) / 3600 ))
    if [ ! -d "$dir" ]; then
      limit=0 why="folder gone"
    elif is_temporary "$dir"; then
      limit=$TEMP_SESSION_HOURS why="temporary folder, ${idle}h idle"
    else
      limit=$SESSION_HOURS why="${idle}h idle"
    fi
    if [ "$idle" -ge "$limit" ]; then
      act "remove session $name ($why: $dir)" tmux kill-session -t "=$name"
    fi
  done < <(tmux list-sessions -F '#{session_name}	#{session_attached}	#{session_activity}	#{session_path}' 2> /dev/null)
}

case "${1:-}" in
  "") ;;
  --dry-run) DRY_RUN=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac

# No server, nothing to do
tmux list-sessions > /dev/null 2>&1 || exit 0

NOW=$(date +%s)
reap_terminals
reap_sessions
